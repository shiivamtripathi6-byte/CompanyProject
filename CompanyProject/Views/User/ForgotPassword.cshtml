@model CompanyProject.Models.ForgotPassword

@{
    ViewBag.Title = "ForgotPassword";
    Layout = "~/Views/Shared/HomeLayout.cshtml";
}

<div class="container mt-5" style="max-width:500px;">
    <h2 class="text-center mb-4">ForgetPassword</h2>

    @if (ViewBag.msg != null)
    {
        <div class="msgDiv alert alert-info">@ViewBag.msg</div>
    }
   
    @using (Html.BeginForm("ForgotPassword", "User", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div>
        <label>User ID</label>
       @Html.TextBoxFor(m => m.UserId, new { placeholder = "Enter your User Id"})
        @Html.ValidationMessageFor(m => m.UserId)
        </div>
        <br />
        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
    }
    <div class="mt-3 text-center">
        <a href="@Url.Action("Login","User")">Back to Login</a>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    window.onload = function () {

        setTimeout(function () {

            $(".msgDiv").fadeOut("slow");

        }, 1000);

    };
</script>