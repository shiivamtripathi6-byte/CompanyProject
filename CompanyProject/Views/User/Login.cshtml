@model CompanyProject.Models.Login
@{
    ViewBag.Title = "Login";
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/font-awesome.min.css" rel="stylesheet" />
<link href="~/Content/User.css" rel="stylesheet" />
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card mt-5 shadow">
                <div class="card-header text-center bg-success text-white">
                    <h1><span class="fa fa-lock"></span>User Login</h1>
                </div> 
                <div class="card-body">
                    @using(Html.BeginForm("Login", "User", FormMethod.Post))
                    {
                        <div class="form-group">
                            @Html.LabelFor(model => model.UserId)
                            @Html.TextBoxFor(model => model.UserId, new { @class = "form-control", placeholder = "Enter User Id"})
                            @Html.ValidationMessageFor(model => model.UserId, "", new { @class = "text-danger"})
                        </div>
                        
                        <div class="form-group mt-3">
                            @Html.LabelFor(model => model.Password)
                            @Html.TextBoxFor(model => model.Password, new { @class = "form-contorl"})
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger"})
                        </div>
                        <div class="row">
                            <div class="col-4" style="margin-top:8%">
                                <h2 id="cph">@ViewBag.cph</h2>
                                <input type="hidden" name="txtcaptcha" value="@ViewBag.cph" />
                            </div>
                            <div class="col-2" style="margin-top:3%; font-size:40px; color:green">
                                <span class="fa fa-refresh btn-lg btn-info" style="font-size:40px"></span>  
                                 
                            </div>
                            <div class="col-6">Captcha Code Here
                            <input type="text" name="txtcaptchacode" class="form-control" />
                            </div>
                        </div>
                        <br />
                        <label>
                            @Html.CheckBoxFor(model => model.RememberMe) Remember Me
                        </label>
                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-success w-100"><span class="fa fa-sign-in"></span>Login</button>  
                        </div> 
                        <br />
                        <div class="form-group">
                        <a href="/User/ForgotPassword" class="btn btn-danger">
                          Forgot Password?
                        </a>
                       </div>
                    }
                       <span class="text-success success-msg">@ViewBag.msg</span> 
                    </div>  
                   </div>
                 </div> 
                </div>
              </div>
             <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
          <script>
        $(document).ready(function () {
        $("#cph,input[name='txtcaptchacode']").on("cut copy paste", function (e) {
            e.preventDefault();
        })
        $(".fa-refresh").click(function () {
            $.ajax({
                type: "Post",
                url: "/User/RefreshCaptcha",
                success: function (data) {
                    $("#cph").text(data);
                    $("input[name='txtcaptcha']").val(data);
                }
            })
        })
    })
</script>