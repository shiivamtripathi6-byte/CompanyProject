@model CompanyProject.Models.ResetPassword
@{
    ViewBag.Title = "ResetPassword";
    Layout = "~/Views/Shared/HomeLayout.cshtml";
}

<div class="container mt-5" style="max-width:500px;">
    <h2 class="text-center mb-4">Reset Password</h2>

    @if (ViewBag.msg != null)
    {
        <div class="msgDiv alert alert-info">@ViewBag.msg</div>
    }

    @using (Html.BeginForm("ResetPassword", "User", FormMethod.Post))
    {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Token)
            @Html.HiddenFor(m => m.UserId)
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.NewPassword, "New Password")
            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password" })
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.ConfirmPassword, "Confirm Password")
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm password" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success w-100">Reset Password</button>
    }

    <div class="mt-3 text-center">
        <a href="@Url.Action("Login","User")">Back to Login</a>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    window.onload = function () {

        setTimeout(function () {

            $(".msgDiv").fadeOut("slow");

        }, 1000);

    };
</script>