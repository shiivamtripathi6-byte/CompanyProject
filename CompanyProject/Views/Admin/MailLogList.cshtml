@model IEnumerable<CompanyProject.Models.MailLog>
@{
    ViewBag.Title = "MailLogList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
<div class="container-fluid py-4">
  
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0 text-dark">
                Mail Log List
            </h4>
            <small class="text-muted">
                Monitor all system generated email logs
            </small>
        </div>
        <div>
            <span class="badge bg-primary fs-6 shadow-sm">
                Total: @Model.Count()
            </span>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="basic-1" class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">MailId</th>
                            <th>To</th>
                            <th class="text-center">UserId</th>
                            <th>Subject</th>
                            <th>Body</th>
                            <th class="text-center">DateTime</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <span class="fw-bold text-primary">
                                            #@item.MailId
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @item.To
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">
                                            @item.UserId
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">
                                            @item.Subject
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Body))
                                        {
                                            <a href="@item.Body" target="_blank" class="text-decoration-none fw-semibold text-primary">
                                                @item.Body
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-semibold">
                                                No Link
                                            </span>
                                        }
                                    </td>
                                       <td class="text-center text-muted">
                                        @item.DateTime.ToString("dd MMM yyyy")
                                        <br />
                                        <small>
                                            @item.DateTime.ToString("hh:mm tt")
                                        </small>
                                      </td>
                                  </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-danger fw-bold py-4">
                                    No Mail Logs Found

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f6f9;
    }

    .card {
        border-radius: 12px;
    }

    .table thead th {
        font-size: 13px;
        font-weight: 600;
        color: #495057;
        background-color: #f8f9fa;
    }

    .table tbody td {
        font-size: 14px;
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f5f9;
        transition: 0.2s;
    }

    .badge {
        font-size: 12px;
        padding: 6px 10px;
        border-radius: 6px;
    }
</style>
<script src="~/Scripts/js/js-datatables/datatables/jquery.dataTables.min.js"></script>
<script src="~/Scripts/js/js-datatables/datatables/datatable.custom.js"></script>
<script src="~/Scripts/js/js-datatables/datatables/datatable.custom1.js"></script>
<script src="~/Scripts/js/datatable/datatables/datatable.custom.js"></script>