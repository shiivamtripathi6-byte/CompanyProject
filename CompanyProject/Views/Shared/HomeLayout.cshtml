<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Optional Custom CSS -->
    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-custom {
            background-color: #0d3b66;
        }

       .navbar-custom .nav-link,
       .navbar-custom .navbar-brand {
            color: white;
        }

       .navbar-custom .nav-link:hover {
            color: #ffc107;
        }

        footer {
            background-color: #0d3b66;
            color: white;
            padding: 15px;
            text-align: center;
            margin-top: 30px;
        }
    </style>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">

                <a class="navbar-brand fw-bold" href="@Url.Action("Index","Home")">
                    📚 Library System
                </a>

                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#userNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="userNavbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index","User")">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("UserBookingList","User")">
                                Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="/User/Login1?mode=register">Register</a>          
                        </li>  
                    </ul>
                    @{
                        if (Session["UserId"] == null)
                        {
                            if (Request.Cookies["Login"] != null)
                            {
                                Session["UserId"] = Request.Cookies["Login"]["UserId"];
                            }
                        }
                    }
                    <ul class="navbar-nav">

                        @if (Session["IsImpersonating"] != null)
                        {
                            <button onclick="window.history.back()" class="btn btn-primary">
                            Back to Admin
                            </button>
                        }
                        
                        @if (Session["UserId"] == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login","User")">
                                    Login
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("LogOut","User")">
                                    Logout
                                </a>
                            </li>
                        }  
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container mt-4">
            @RenderBody()
        </div>
        <footer>
            <p>
                © @DateTime.Now.Year Library Management System |
                All Rights Reserved
            </p>
        </footer>
        <!-- Bootstrap JS -->
        <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    </body>
</html>

   
